# Base de données. En local : PGlite en fichier (ADR 0010), par exemple pglite:./.data/dev.
# En production : la chaîne de connexion Neon (fournie par l'intégration Vercel).
DATABASE_URL=

# Production uniquement : URL directe de Neon, sans pooler, utilisée par les migrations au build.
DATABASE_URL_UNPOOLED=

# Secret de signature des sessions Better Auth, 32 caractères minimum : openssl rand -base64 32
BETTER_AUTH_SECRET=

# URL publique de l'app (origine autorisée), par exemple http://localhost:3000 en local.
BETTER_AUTH_URL=

# Facultatif : « off » coupe les appels à Open Food Facts (tests de bout en bout, développement hors ligne).
OPEN_FOOD_FACTS=
